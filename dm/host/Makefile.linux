# Linux host (Asahi on Apple silicon): make -f Makefile.linux GAME=<base game title ID>, inside the dev shell (nix develop at the repository root).
# The shared host sources build unchanged against linux/: Darwin header stand-ins and darwin_compat.c (force-included), linux/sections.ld for the registration
# tables, and the Mach-O assembly translated to ELF (gen/linux/asm). Modules must be rewritten for this host: DM_THREAD_REG=tpidr_el0 (dm/tools/nso_asm.py).
# Headless for now: the Objective-C front end and the Metal graphics are left out, and linux/headless.c stands in for what the C sources call in them.
ifeq ($(strip $(GAME)),)
ifneq ($(filter-out clean t_tpslot t_sigctx linux-tests t_spv_compile t_placed,$(or $(MAKECMDGOALS),dmhost)),)
$(error GAME is not set: make -f Makefile.linux GAME=<base game title ID>)
endif
endif
# GEN: where everything built goes (objects, generated headers, linked profiles), and OUT the host binary. Both default to this folder; the installed app (flake.nix)
# builds from its read-only source with them in a writable folder (scripts/build_ipa_from_nsp.py, NXASAHI_STATE)
GEN ?= gen
OUT ?= dmhost
ifneq ($(strip $(GAME)),)
GAME_DIR := $(if $(and $(wildcard ../games/$(GAME)/game.tsv),$(if $(DM_GAMES_FIRST),,1)),../games/$(GAME),$(shell python3 ../games/game.py link $(GAME) $(GEN)/$(GAME)/profile >&2 && echo $(GEN)/$(GAME)/profile))
endif
GAME_H = $(GEN)/$(GAME)/game_profile.h
# Objects per game: they are compiled against its profile header, and a shared folder took one game's objects for another's when its header was the older
O = $(GEN)/linux$(if $(strip $(GAME)),/$(GAME))
CC = clang
CFLAGS = -O1 -g -Wall -Wno-unused-function -std=gnu11 -fblocks -D_GNU_SOURCE -Ilinux -include darwin_compat.h \
         -I. -I../gfx/nvn/include -I../third_party/vulkan-headers/include -I$(dir $(GAME_H)) -I../third_party/libvpx -I../third_party/stb_vorbis $(shell pkg-config --cflags sdl3 libavcodec libswscale)
LDFLAGS = -fuse-ld=lld -rdynamic -Wl,-T,linux/sections.ld
LIBS = -lBlocksRuntime -lm -lpthread -ldl $(shell pkg-config --libs sdl3 vulkan libavcodec libswscale libavutil)

# hle_movie_avc.c is VideoToolbox: linux/movie_avc_ffmpeg.c implements its interface (and linux/audioconverter_ffmpeg.c AAC), on FFmpeg. hle_bigstack.c has Mach-O inline assembly: built from its translation
HOST_C = main.c loader.c hle.c crash.c probe.c thread.c $(filter-out hle_movie_avc.c hle_bigstack.c,$(sort $(wildcard hle_*.c)))
GFX_C = $(sort $(wildcard ../gfx/*.c ../gfx/nvn/*.c ../gfx/tex/*.c))
LINUX_C = $(sort $(wildcard linux/*.c))
ASM = entry.S ../gfx/nvn/nvn_entry.S ../gfx/nvn/nvn_thunks.S
OBJ = $(patsubst %.c,$(O)/%.o,$(notdir $(HOST_C) $(GFX_C))) $(patsubst linux/%.c,$(O)/linux_%.o,$(LINUX_C)) $(O)/hle_bigstack.o $(patsubst %.S,$(O)/asm_%.o,$(notdir $(ASM)))
vpath %.c . ../gfx ../gfx/nvn ../gfx/tex
vpath %.S . ../gfx/nvn

# Mach-O → ELF assembly: linux/darwin_asm.sed
DARWIN_ASM = sed -E -f linux/darwin_asm.sed

.DEFAULT_GOAL := $(OUT)
$(GAME_H): $(GAME_DIR)/game.tsv ../games/game.py FORCE
	@python3 ../games/game.py header $(GAME) $@
.PHONY: FORCE clean
FORCE:

$(O)/%.o: %.c $(GAME_H) $(wildcard *.h linux/*.h ../gfx/nvn/*.h ../gfx/tex/*.h)
	@mkdir -p $(O)
	$(CC) $(CFLAGS) -c $< -o $@
$(O)/linux_%.o: linux/%.c $(wildcard linux/*.h)
	@mkdir -p $(O)
	$(CC) $(CFLAGS) -c $< -o $@
# Only the string literals of the inline assembly are translated, so no C identifier changes
$(O)/hle_bigstack.c: hle_bigstack.c linux/darwin_asm.sed
	@mkdir -p $(O)
	sed -E -e '/^[[:space:]]*"/!b' -f linux/darwin_asm.sed $< > $@
$(O)/hle_bigstack.o: $(O)/hle_bigstack.c $(GAME_H)
	$(CC) $(CFLAGS) -c $< -o $@
$(O)/asm_%.S: %.S linux/darwin_asm.sed
	@mkdir -p $(O)
	$(DARWIN_ASM) $< > $@
$(O)/asm_%.o: $(O)/asm_%.S
	$(CC) -c $< -o $@

# libvpx (VP8 / VP9 movies), as in Makefile (stb_vorbis is #included by hle_movie.c)
VPX = ../third_party/libvpx
VPX_SRC = $(sort $(shell find $(VPX) -name '*.c'))
VPX_OBJ = $(patsubst $(VPX)/%.c,$(O)/vpx/%.o,$(VPX_SRC))
$(O)/vpx/%.o: $(VPX)/%.c
	@mkdir -p $(dir $@)
	$(CC) -O2 -g -I$(VPX) -I$(VPX)/config -c $< -o $@
$(O)/libvpx.a: $(VPX_OBJ)
	rm -f $@; ar rcs $@ $^

$(OUT): $(OBJ) $(O)/libvpx.a linux/sections.ld
	@mkdir -p $(dir $(OUT))
	$(CC) $(LDFLAGS) -o $@ $(OBJ) $(O)/libvpx.a $(LIBS)
ifneq ($(OUT),dmhost)
.PHONY: dmhost
dmhost: $(OUT)
endif
clean:
	rm -rf $(O) $(OUT)

# Tests of the Linux layer itself (linux/tests): the thread-slot scheme and the Darwin-shaped signal context
.PHONY: t_tpslot t_sigctx linux-tests
$(O)/t_tpslot: linux/tests/t_tpslot.c
	@mkdir -p $(O)
	$(CC) -O1 -g -Wall -o $@ $< -lpthread
$(O)/t_sigctx: linux/tests/t_sigctx.c $(O)/linux_darwin_compat.o
	$(CC) -O1 -g -Wall -fblocks -D_GNU_SOURCE -Ilinux -o $@ $< $(O)/linux_darwin_compat.o $(LIBS)
t_tpslot: $(O)/t_tpslot
	$<
t_sigctx: $(O)/t_sigctx
	$<
linux-tests: t_tpslot t_sigctx

# Compile every translated shader on the GPU (dm/gfx/tools/dmsh_spv.py output): make -f Makefile.linux t_spv_compile SPV=<dir>/spv-<chain version>
$(O)/t_spv_compile: linux/tests/t_spv_compile.c linux/spv_reflect.c linux/spv_reflect.h
	@mkdir -p $(O)
	$(CC) -O2 -g -Wall -Ilinux -o $@ linux/tests/t_spv_compile.c linux/spv_reflect.c $(shell pkg-config --libs vulkan) -lpthread
t_spv_compile: $(O)/t_spv_compile
	$< $(SPV)

# The Vulkan backend's memory design on the device: chunks of guest memory backed in place, one sparse buffer per region (linux/tests/t_placed.c)
$(O)/t_placed.spv.inc: linux/tests/t_placed.comp
	@mkdir -p $(O)
	glslangValidator -V --target-env vulkan1.3 -x -o $@ $< >/dev/null
$(O)/t_placed: linux/tests/t_placed.c $(O)/t_placed.spv.inc
	$(CC) -O1 -g -Wall -I$(O) -o $@ $< $(shell pkg-config --libs vulkan)
t_placed: $(O)/t_placed
	$<
